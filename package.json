{
	"name": "declutter",
	"private": true,
	"type": "module",
	"scripts": {
		"dev:producer": "pnpm --filter @declutter/producer dev",
		"dev:consumer": "pnpm --filter @declutter/consumer dev",
		"dev:api": "pnpm --filter @declutter/api dev",
		"dev:bloom": "pnpm --filter @declutter/bloom-rotator dev",
		"build": "pnpm -r build",
		"lint": "oxlint .",
		"format": "oxfmt .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@types/node": "^20.19.30",
		"@vitest/coverage-v8": "^4.1.1",
		"concurrently": "^9.2.1",
		"oxfmt": "^0.34.0",
		"oxlint": "^1.49.0",
		"vitest": "^4.1.1"
	}
}
